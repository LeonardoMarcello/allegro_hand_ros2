<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- TIP's MACROS -->
  <xacro:macro name="default_tip">
    <visual>
      <geometry>
        <mesh filename="meshes/link_3.0_tip.STL"/>
      </geometry>
      <material name="white">
        <color rgba=".9 .9 .9 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0168" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="9.68e-07" ixy="0" ixz="0" iyy="9.68e-07" iyz="0" izz="9.68e-07" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="weiss_tip">
    <visual>
      <geometry>
        <mesh filename="meshes/sensing_tip.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <origin rpy="1.5707963259 0 1.5707963259" xyz="-0.0095 0 0" />
      <material name="white">
        <color rgba=".9 .9 .9 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.012" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0168" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="optoforce_tip">
    <visual>
      <geometry>
        <mesh filename="meshes/OptoforceTip.dae"/>
      </geometry>
      <origin rpy="0.0 -0.7853981 0.0" xyz="0.0023 0.0 -0.0122" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/OptoforceTip.dae"/>
      </geometry>
      <origin rpy="0.0 -0.7853981 0.0" xyz="0.0023 0.0 -0.0122" />
      <!--<sphere radius="0.012" /> -->
    </collision>
    <inertial>
      <mass value="0.0168" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </xacro:macro>

  <!-- LINK's MACROS -->
  <xacro:macro name="link_0">
    <visual>
      <geometry>
        <mesh filename="meshes/link_0.STL" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.0196 0.0275 0.0164" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.0082" />
    </collision>
    <inertial>
      <mass value="0.0119" />
      <origin xyz="0.012303 -0.012311 0" />
      <inertia ixx="1.01666658333e-06" ixy="0.0" ixz="0.0" iyy="6.47677333333e-07" iyz="0.0" izz="1.01666658333e-06" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="link_1">
    <visual>
      <geometry>
        <mesh filename="meshes/link_1.STL" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.0196 0.0275 0.054" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.027" />
    </collision>
    <inertial>
      <mass value="0.065" />
      <origin xyz="0.010769 -0.004809 0.026154" />
      <inertia ixx="7.95654166667e-05" ixy="1.7199e-05" ixz="8.75875e-06" iyy="2.47088833333e-05" iyz="2.413125e-05" izz="7.95654166667e-05" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="link_2">
    <visual>
      <geometry>
        <mesh filename="meshes/link_2.STL" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.0196 0.0275 0.0384" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.0192" />
    </collision>
    <inertial>
      <mass value="0.037009160547828809" />
      <origin xyz="0.010528 -0.010246 0.037828" />
      <inertia ixx="2.63979183333e-05" ixy="6.67968e-06" ixz="4.783625e-06" iyy="1.34948516667e-05" iyz="9.372e-06" izz="2.63979183333e-05" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="link_3">
    <visual>
      <geometry>
        <mesh filename="meshes/link_3.STL" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.0196 0.0275 0.0267" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.01335" />
    </collision>
    <inertial>
      <mass value="0.031366974030183042" />
      <origin xyz="0.012497 -0.019128 0.058662" />
      <inertia ixx="4.701248e-06" ixy="1.255968e-06" ixz="1.2936e-06" iyy="3.649312e-06" iyz="1.7622e-06" izz="4.701248e-06" />
    </inertial>
  </xacro:macro>

  <!-- ALLEGRO HAND MACRO -->
    <xacro:macro name="right_allegro_hand" params="link_prefix joint_prefix tip parent *origin">

    <joint name="${link_prefix}base_joint" type="fixed">
        <xacro:insert_block name="origin" />
        <parent link="${parent}"/>
        <child link="${link_prefix}base_link"/>
    </joint>

    <!-- LINKS -->
    <link name="${link_prefix}base_link">
      <visual>
        <geometry>
          <mesh filename="meshes/base_link.STL"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0 "/>
        <material name="black">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="-0.009300 0 -0.0475"/>
        <geometry>
          <box size="0.0408 0.1130 0.095"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.095" rpy="0 0 0"/>
        <mass value="0.4154"/>
        <inertia ixx="1e-4" ixy="0.0" ixz="0.0" iyy="1e-4" iyz="0.0" izz="1e-4"/>
      </inertial>
    </link>

    <link name="${link_prefix}link_12_0">
      <visual>
        <geometry>
          <mesh filename="meshes/link_12_right.STL"/>
        </geometry>
        <material name="black">
          <color rgba=".2 .2 .2 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.0358 0.034 0.0455"/>
        </geometry>
        <origin rpy="0 0 0" xyz="-0.0179 0.009 0.0145"/>
      </collision>
      <inertial>
        <mass value="0.0176" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1.89273333333e-5" ixy="7.16716e-06" ixz="5.35568e-06" iyy="1.43008213333e-05" iyz="6.8068e-06" izz="1.89273333333e-05" />
      </inertial>
    </link>

    <link name="${link_prefix}link_13_0">
      <visual>
        <geometry>
          <mesh filename="meshes/link_13.STL"/>
        </geometry>
        <material name="black">
          <color rgba=".2 .2 .2 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.0196 0.0275 0.0177"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.00885"/>
      </collision>
      <inertial>
        <mass value="0.0119" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="4.24250866667e-06" ixy="1.032087e-06" ixz="1.603525e-06" iyy="4.52362633333e-06" iyz="1.44808125e-06" izz="4.24250866667e-06" />
      </inertial>
    </link>

    <link name="${link_prefix}link_14_0">
      <visual>
        <geometry>
          <mesh filename="meshes/link_14.STL"/>
        </geometry>
        <material name="black">
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.0196 0.0275 0.0514"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.0257"/>
      </collision>
      <inertial>
        <mass value="0.038" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="4.30439933333e-05" ixy="9.57068e-06" ixz="5.1205e-06" iyy="1.44451933333e-05" iyz="1.342825e-05" izz="4.30439933333e-05" />
      </inertial>
    </link>

    <link name="${link_prefix}link_15_0">
      <visual>
        <geometry>
          <mesh filename="meshes/link_15.STL"/>
        </geometry>
        <material name="black">
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.0196 0.0275 0.0423"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.02115"/>
      </collision>
      <inertial>
        <mass value="0.0388" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="3.29223173333e-05" ixy="8.042076e-06" ixz="5.2283e-06" iyy="1.47493026667e-5" iyz="1.1283525e-5" izz="3.29223173333e-05" />
      </inertial>
    </link>

    <link name="${link_prefix}link_0_0">
      <xacro:link_0 />
    </link>

    <link name="${link_prefix}link_1_0">
      <xacro:link_1 />
    </link>

    <link name="${link_prefix}link_2_0">
      <xacro:link_2 />
    </link>

    <link name="${link_prefix}link_3_0">
      <xacro:link_3 />
    </link>

    <!-- Middle -->
    <link name="${link_prefix}link_4_0">
      <xacro:link_0 />
    </link>

    <link name="${link_prefix}link_5_0">
      <xacro:link_1 />
    </link>

    <link name="${link_prefix}link_6_0">
      <xacro:link_2 />
    </link>
    <link name="${link_prefix}link_7_0">
      <xacro:link_3 />
    </link>

    <!-- Ring -->
    <link name="${link_prefix}link_8_0">
      <xacro:link_0 />
    </link>

    <link name="${link_prefix}link_9_0">
      <xacro:link_1 />
    </link>

    <link name="${link_prefix}link_10_0">
      <xacro:link_2 />
    </link>

    <link name="${link_prefix}link_11_0">
      <xacro:link_3 />
    </link>

    <!-- ################################################# -->
    <!-- JOINTS -->
    <!-- INDEX FINGER -->
    <joint name="${joint_prefix}joint_0_0" type="revolute">
      <axis xyz="0 0 +1" />
      <limit effort="0.7" lower="-0.596932" upper="0.588071" velocity="3" />
      <parent link="${link_prefix}base_link" />
      <child link="${link_prefix}link_0_0" />
      <origin rpy="-0.08726646255 0 0" xyz="0 0.0435 -0.001542" />
      <dynamics damping="0.021307336803783977" friction="0.06754533316058077" />
    </joint>

    <joint name="${joint_prefix}joint_1_0" type="revolute">
      <limit effort="0.7" lower="-0.28422" upper="1.79806" velocity="3" />
      <axis xyz="0 +1 0" />
      <parent link="${link_prefix}link_0_0" />
      <child link="${link_prefix}link_1_0" />
      <origin xyz="0 0 0.0164" />
      <dynamics damping="0.01767730238754802" friction="0.046834261267951538" />
    </joint>

    <joint name="${joint_prefix}joint_2_0" type="revolute">
      <axis xyz="0 +1 0" />
      <limit effort="0.7" lower="-0.277444" upper="1.77296" velocity="3" />
      <parent link="${link_prefix}link_1_0" />
      <child link="${link_prefix}link_2_0" />
      <origin xyz="0 0 0.054" />
      <dynamics damping="0.031774638864325758" friction="0.016627969777092133" />
    </joint>

    <joint name="${joint_prefix}joint_3_0" type="revolute">
      <axis xyz="0 +1 0" />
      <limit effort="0.7" lower="-0.282001" upper="1.76087" velocity="3" />
      <parent link="${link_prefix}link_2_0" />
      <child link="${link_prefix}link_3_0" />
      <origin xyz="0 0 0.0384" />
      <dynamics damping="0.038319998323206518" friction="0.021242402695969654" />
    </joint>

    <!-- MIDDLE FINGER -->
    <joint name="${joint_prefix}joint_4_0" type="revolute">
      <axis xyz="0 0 +1" />
      <limit effort="0.7" lower="-0.596932" upper="0.588071" velocity="3" />
      <parent link="${link_prefix}base_link" />
      <child link="${link_prefix}link_4_0" />
      <origin rpy="0.0 0 0" xyz="0 0 0.0007" />
      <dynamics damping="0.03919965995816594" friction="0.039832089332686435" />
    </joint>

    <joint name="${joint_prefix}joint_5_0" type="revolute">
      <limit effort="0.7" lower="-0.28422" upper="1.79806" velocity="3" />
      <axis xyz="0 +1 0" />
      <parent link="${link_prefix}link_4_0" />
      <child link="${link_prefix}link_5_0" />
      <origin xyz="0 0 0.0164" />
      <dynamics damping="0.03873626118353872" friction="0.054137945660864321" />
    </joint>

    <joint name="${joint_prefix}joint_6_0" type="revolute">
      <axis xyz="0 +1 0" />
      <limit effort="0.7" lower="-0.277444" upper="1.77296" velocity="3" />
      <parent link="${link_prefix}link_5_0" />
      <child link="${link_prefix}link_6_0" />
      <origin xyz="0 0 0.054" />
      <dynamics damping="0.038096107794554551" friction="0.016501055223839444" />
    </joint>

    <joint name="${joint_prefix}joint_7_0" type="revolute">
      <axis xyz="0 +1 0" />
      <limit effort="0.7" lower="-0.282001" upper="1.76087" velocity="3" />
      <parent link="${link_prefix}link_6_0" />
      <child link="${link_prefix}link_7_0" />
      <origin xyz="0 0 0.0384" />
      <dynamics damping="0.030909594496839752" friction="0.018861768610753726" />
    </joint>

    <!-- RING FINGER  -->
    <joint name="${joint_prefix}joint_8_0" type="revolute">
      <axis xyz="0 0 +1" />
      <limit effort="0.7" lower="-0.596932" upper="0.588071" velocity="3" />
      <parent link="${link_prefix}base_link" />
      <child link="${link_prefix}link_8_0" />
      <origin rpy="0.08726646255 0 0" xyz="0 -0.0435 -0.001542" />
      <dynamics damping="0.021307336803783977" friction="0.06754533316058077" />
    </joint>

    <joint name="${joint_prefix}joint_9_0" type="revolute">
      <limit effort="0.7" lower="-0.28422" upper="1.79806" velocity="3" />
      <axis xyz="0 +1 0" />
      <parent link="${link_prefix}link_8_0" />
      <child link="${link_prefix}link_9_0" />
      <origin xyz="0 0 0.0164" />
      <dynamics damping="0.01767730238754802" friction="0.046834261267951538" />
    </joint>

    <joint name="${joint_prefix}joint_10_0" type="revolute">
      <axis xyz="0 +1 0" />
      <limit effort="0.7" lower="-0.277444" upper="1.77296" velocity="3" />
      <parent link="${link_prefix}link_9_0" />
      <child link="${link_prefix}link_10_0" />
      <origin xyz="0 0 0.054" />
      <dynamics damping="0.031774638864325758" friction="0.016627969777092133" />
    </joint>

    <joint name="${joint_prefix}joint_11_0" type="revolute">
      <axis xyz="0 +1 0" />
      <limit effort="0.7" lower="-0.282001" upper="1.76087" velocity="3" />
      <parent link="${link_prefix}link_10_0" />
      <child link="${link_prefix}link_11_0" />
      <origin xyz="0 0 0.0384" />
      <dynamics damping="0.038319998323206518" friction="0.021242402695969654" />
    </joint>

    <!-- THUMB FINGER -->
    <joint name="${joint_prefix}joint_12_0" type="revolute">
      <axis xyz="-1 0 0"/>
      <limit effort="0.7" lower="0.218668" upper="1.53294" velocity="3"/>
      <parent link="${link_prefix}base_link"/>
      <child link="${link_prefix}link_12_0"/>
      <origin rpy="0 -1.65806278845 -1.5707963259" xyz="-0.0182 0.019333 -0.045987"/>
    </joint>

    <joint name="${joint_prefix}joint_13_0" type="revolute">
      <axis xyz="0 0 +1"/>
      <limit effort="0.7" lower="-0.396993" upper="1.20296" velocity="3"/>
      <parent link="${link_prefix}link_12_0"/>
      <child link="${link_prefix}link_13_0"/>
      <origin xyz="-0.027 0.005 0.0399"/>
    </joint>

    <joint name="${joint_prefix}joint_14_0" type="revolute">
      <axis xyz="0 +1 0"/>
      <limit effort="0.7" lower="-0.251244" upper="1.76701" velocity="3"/>
      <parent link="${link_prefix}link_13_0"/>
      <child link="${link_prefix}link_14_0"/>
      <origin xyz="0 0 0.0177"/>
    </joint>

    <joint name="${joint_prefix}joint_15_0" type="revolute">
      <axis xyz="0 +1 0"/>
      <limit effort="0.7" lower="-0.260209" upper="1.82262" velocity="3"/>
      <parent link="${link_prefix}link_14_0"/>
      <child link="${link_prefix}link_15_0"/>
      <origin xyz="0 0 0.0514"/>
    </joint>


    <!-- ################################################# -->
    <!-- TIP's SET -->
    <xacro:if value="${tip == 'weiss'}">
      <link name="${link_prefix}link_3_0_tip">
        <xacro:weiss_tip/>
      </link>

      <link name="${link_prefix}link_7_0_tip">
        <xacro:weiss_tip/>
      </link>

      <link name="${link_prefix}link_11_0_tip">
        <xacro:weiss_tip/>
      </link>

      <link name="${link_prefix}link_15_0_tip">
        <xacro:weiss_tip/>
      </link>

      <joint name="${joint_prefix}joint_3_0_tip" type="fixed">
        <parent link="${link_prefix}link_3_0" />
        <child link="${link_prefix}link_3_0_tip" />
        <origin rpy="0 0 0" xyz="0.01335 0 0.0408" />
      </joint>

      <joint name="${joint_prefix}joint_7_0_tip" type="fixed">
        <parent link="${link_prefix}link_7_0" />
        <child link="${link_prefix}link_7_0_tip" />
        <origin rpy="0 0 0" xyz="0.01335 0 0.0408" />
      </joint>

      <joint name="${joint_prefix}joint_11_0_tip" type="fixed">
        <parent link="${link_prefix}link_11_0" />
        <child link="${link_prefix}link_11_0_tip" />
        <origin rpy="0 0 0" xyz="0.01335 0 0.0408" />
      </joint>

      <joint name="${joint_prefix}joint_15_0_tip" type="fixed">
        <parent link="${link_prefix}link_15_0" />
        <child link="${link_prefix}link_15_0_tip" />
        <origin rpy="0 0 0" xyz="0.01335 0 0.0564" />
      </joint>
    </xacro:if>

    <xacro:if value="${tip == 'optoforce'}">
      <link name="${link_prefix}link_3_0_tip">
        <xacro:optoforce_tip/>
      </link>

      <link name="${link_prefix}link_7_0_tip">
        <xacro:optoforce_tip/>
      </link>

      <link name="${link_prefix}link_11_0_tip">
        <xacro:optoforce_tip/>
      </link>

      <link name="${link_prefix}link_15_0_tip">
        <xacro:optoforce_tip/>
      </link>

      <joint name="${joint_prefix}joint_3_0_tip" type="fixed">
        <parent link="${link_prefix}link_3_0" />
        <child link="${link_prefix}link_3_0_tip" />
        <origin rpy="0 0.7853981 0" xyz="0.007 0.0 0.037" />
        <!--origin rpy="0 0 0" xyz="0.01335 0 0.0408" /> -->
      </joint>

      <joint name="${joint_prefix}joint_7_0_tip" type="fixed">
        <parent link="${link_prefix}link_7_0" />
        <child link="${link_prefix}link_7_0_tip" />
        <origin rpy="0 0.7853981 0" xyz="0.007 0.0 0.037" />
        <!--origin rpy="0 0 0" xyz="0.01335 0 0.0408" /> -->
      </joint>

      <joint name="${joint_prefix}joint_11_0_tip" type="fixed">
        <parent link="${link_prefix}link_11_0" />
        <child link="${link_prefix}link_11_0_tip" />
        <origin rpy="0 0.7853981 0" xyz="0.007 0.0 0.037" />
        <!--origin rpy="0 0 0" xyz="0.01335 0 0.0408" /> -->
      </joint>

      <joint name="${joint_prefix}joint_15_0_tip" type="fixed">
        <parent link="${link_prefix}link_15_0" />
        <child link="${link_prefix}link_15_0_tip" />
        <origin rpy="0 0.7853981 0" xyz="0.007 0.0 0.0527" />
        <!--origin rpy="0 0 0" xyz="0.01335 0 0.0564" /> -->
      </joint>
    </xacro:if>

    <xacro:unless value="${tip == 'weiss' or tip == 'optoforce'}">
      <link name="${link_prefix}link_3_0_tip">
        <xacro:default_tip/>
      </link>

      <link name="${link_prefix}link_7_0_tip">
        <xacro:default_tip/>
      </link>

      <link name="${link_prefix}link_11_0_tip">
        <xacro:default_tip/>
      </link>

      <link name="${link_prefix}link_15_0_tip">
        <xacro:default_tip/>
      </link>

      <joint name="${joint_prefix}joint_3_0_tip" type="fixed">
        <parent link="${link_prefix}link_3_0"/>
        <child link="${link_prefix}link_3_0_tip"/>
        <origin rpy="0 0 0" xyz="0 0 0.0267"/>
      </joint>

      <joint name="${joint_prefix}joint_7_0_tip" type="fixed">
        <parent link="${link_prefix}link_7_0"/>
        <child link="${link_prefix}link_7_0_tip"/>
        <origin rpy="0 0 0" xyz="0 0 0.0267"/>
      </joint>

      <joint name="${joint_prefix}joint_11_0_tip" type="fixed">
        <parent link="${link_prefix}link_11_0"/>
